/*                KEY POSITIONS

  ╭─────────────────────────╮ ╭─────────────────────────╮
  │ LT5 LT4 LT3 LT2 LT1 LT0 │ │ RT0 RT1 RT2 RT3 RT4 RT5 │
  │ LM5 LM4 LM3 LM2 LM1 LM0 │ │ RM0 RM1 RM2 RM3 RM4 RM5 │
  │ LB5 LB4 LB3 LB2 LB1 LB0 │ │ RB0 RB1 RB2 RB3 RB4 RB5 │
  ╰───────╮ LH2 LH1 LH0 │ │ RH0 RH1 RH2 ╭───────╯
          ╰─────────────╯ ╰─────────────╯ */
          /* Horizontal combos - left hand */
// ZMK_COMBO(esc,   &kp ESC/* ,      1 2,     DEF NUM , COMBO_TERM_FAST, COMBO_IDLE_FAST) 
// ZMK_COMBO(ret,   &kp RETURN,   2 3,     DEF NUM , COMBO_TERM_FAST, COMBO_IDLE_FAST)
//  */
// Combos overlapping HRMs are set up as hold-taps themselves to allow for instantaneous
// chording of mods. Custom hold-tap instances can be bootstrapped on the go using the
// 8-argument version of ZMK_COMBO defined in base.keymap
// 
// ZMK_COMBO(tab,   &hml LS(LALT)TAB, 13 14, DEF NUM , COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* Horizontal combos - right hand */ 

#define COMBO_TERM 30
#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

ZMK_COMBO(left_parenthesis,  &kp LPAR,         RB1 RB2,    DEF,      COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(right_parenthesis, &kp RPAR,         RB2 RB3,    DEF,      COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(less_than,         &kp LESS_THAN,    RB1 RB2,    NAV NAV2, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(greater_than,      &kp GREATER_THAN, RB2 RB3,    NAV NAV2, COMBO_TERM_FAST, COMBO_IDLE_FAST)

ZMK_COMBO(lbkt,  &kp LBKT,     RM1 RM2,         DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbkt,  &kp RBKT,     RM2 RM3,         DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(lbrc,  &kp LBRC,     RM1 RM2,         NAV NAV2, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(rbrc,  &kp RBRC,     RM2 RM3,         NAV NAV2, COMBO_TERM_FAST, COMBO_IDLE_FAST)

/* Vertical combos - left hand */
ZMK_COMBO(bslh,  &kp BSLH,     LM2 LB1,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
// kevin 
ZMK_MACRO(qtspc,
    bindings = <&macro_tap &kp DQT &kp SPACE>;
) 

ZMK_MACRO(tilspc,
    bindings = <&macro_tap  &kp TILDE &kp SPACE>;
)

ZMK_MACRO(tilde_slash,
    bindings = <&macro_tap &kp TILDE &kp SPACE &kp FSLH>;
)


ZMK_MACRO(g_,
    wait-ms = <0>;
    tap-ms = <50>;
    bindings = <&kp G &kp UNDERSCORE>;
)


ZMK_COMBO(bspc,  &kp LS(RET),     RT1 RT2,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(del,   &tilspc,      RT2 RT3,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)


ZMK_COMBO(tilspcc, &kp LC(SPACE),   LM3 LM2,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(kilo_prefix, &kp COLON, LM1 LM2, DEF, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(num_semi, &kp SEMI, LM1 LM2, NUM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
// sym
ZMK_COMBO(under, &kp UNDER,    LT1 LT2,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(minus, &kp MINUS,    RM1 RB1,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(minus_gb, &kp MINUS, LM0 LB0,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(qmark, &kp QMARK,    LT3 LT2,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(equal, &kp EQUAL,    LB1 LB2,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(pipe, &kp PIPE,    RM0 RB0,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(semi, &kp LC(X),  LB2 LB3,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(plus, &kp PLUS,    LM1 LB1,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)

ZMK_COMBO(tilde, &kp TILDE,    RT1 RM1,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(home_path, &tilde_slash, RT3 RM2,  DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
ZMK_COMBO(qtspccomb, &qtspc, RM1 RT2, DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)


ZMK_COMBO(fslh,  &kp SLASH,    RM2 RB1,     DEF, COMBO_TERM_SLOW, COMBO_IDLE_SLOW)
